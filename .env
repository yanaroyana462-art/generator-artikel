# Application
APP_NAME="Artikel Generator RAG"
ENVIRONMENT="development"
PORT=8000

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_artikel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_artikel

# Gemini LLM API Key (Buka dari Google AI Studio)
GEMINI_API_KEY=AIzaSy_IsiDenganApiKeyGeminiAndaYangAsli

# Embedding Configuration
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"

# RAG Parameters
SIMILARITY_THRESHOLD=0.65
TOP_K_RETRIEVAL=5